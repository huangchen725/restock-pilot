# 复制为项目根目录 .env 后填写真实 key（.env 不进 git）。
# 统一入口和 app 服务自动加载；终端已有变量优先，修改后需重启。

# 书生·端砚 TokenPlan（主链路，兴智杯正式提交用这套）
INTERN_API_KEY=在这里填端砚key
INTERN_API_BASE=https://discovery-api.intern-ai.org.cn/v1
INTERN_MODEL=intern-s2

# 备用：挑战杯端点（调试兜底，RPM 30）
# INTERN_API_BASE=https://chat.intern-ai.org.cn/api/v1
# INTERN_MODEL=intern-s2-preview

# Step 3：真实 Agent（required 默认；off 仅用于离线单测）与采购后台
RESTOCK_AGENT_MODE=required
RESTOCK_AGENT_TIMEOUT_S=600
# 可选：不设置时从 PATH 查找 codex（Windows 支持 .exe / .cmd）。
# 只填程序位置，不附带命令参数；相对路径以项目根目录为基准。
# RESTOCK_CODEX_BIN=./node_modules/.bin/codex.cmd
PROCUREMENT_PORTAL_URL=http://127.0.0.1:8200
RESTOCK_DB_PATH=restock.db
PROCUREMENT_DB_PATH=procurement.db
PROCUREMENT_HEADLESS=true

# 工作台默认通过 start.py 自动获得临时批准凭证，无需配置。
# 只有分开启动 UI/API 或运行独立冒烟脚本时，才在本地 .env 设置相同的随机长值。
# 不要把真实值提交到 Git；修改后重启服务。
# RESTOCK_APPROVAL_TOKEN=
# RESTOCK_API_URL=http://127.0.0.1:8100

# 默认本地 LiteLLM。只用于独立部署/测试端口，统一入口使用 4000。
# 产品 CLI 通过后端临时网关调用它，不继承真实模型密钥或批准凭证。
# RESTOCK_LITELLM_URL=http://127.0.0.1:4000
